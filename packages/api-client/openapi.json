        "properties": {
          "photo_id": {
            "type": "string",
            "format": "uuid"
          },
          "upload_url": {
            "type": "string",
            "description": "URL de PUT direct vers le stockage (valable 15 min)."
          }
        }
      },
      "PublicProfileResponse": {
        "type": "object",
        "required": [
          "pseudo",
          "member_since",
          "items"
        ],
        "properties": {
          "city": {
            "type": [
              "string",
              "null"
            ],
