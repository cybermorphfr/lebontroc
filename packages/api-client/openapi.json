            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "postal_code": {
            "type": "string"
          },
          "pseudo": {
            "type": "string"
          }
        }
      }
