          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            },
            "description": "Objets disponibles uniquement — jamais les masqués."
          },
          "member_since": {
            "type": "string",
            "format": "date-time",
            "description": "Date de création du compte (« Troque depuis… »)."
          },
          "pseudo": {
            "type": "string"
          }
        }
      },
      "ReplacePhotosRequest": {
        "type": "object",
        "required": [
          "photos"
        ],
        "properties": {
          "photos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Liste ordonnée (1–8) : photos déjà rattachées et/ou nouveaux uploads."
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "id",
