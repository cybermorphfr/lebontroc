{
  "openapi": "3.1.0",
  "info": {
    "title": "Lebontroc API",
    "description": "API de la plateforme de troc Lebontroc.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/analytics/track": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Événement d'interface émis par le front (§0.4) — whitelist stricte.",
        "operationId": "track_event",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Événement enregistré"
          },
          "400": {
            "description": "Événement non autorisé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Se connecter.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Connecté",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Identifiants invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Compte temporairement verrouillé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Se déconnecter (révoque la session courante, vide les cookies).",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Déconnecté"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Faire tourner le refresh token (rotation + détection de rejeu).",
        "operationId": "refresh",
        "responses": {
          "204": {
            "description": "Nouveaux cookies posés"
          },
          "401": {
            "description": "Refresh token absent, expiré ou rejoué",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/resend-verification": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Renvoyer l'e-mail de vérification (cooldown 60 s).",
        "operationId": "resend_verification",
        "responses": {
          "204": {
            "description": "E-mail renvoyé (ou compte déjà vérifié)"
          },
          "429": {
            "description": "Renvoi trop rapproché",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/sessions": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Lister ses appareils connectés.",
        "operationId": "list_sessions",
        "responses": {
          "200": {
            "description": "Sessions actives",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionResponse"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Déconnecter tous les autres appareils.",
        "operationId": "revoke_other_sessions",
        "responses": {
          "204": {
            "description": "Autres sessions révoquées"
          }
        }
      }
    },
    "/auth/sessions/{id}": {
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Déconnecter un appareil précis.",
        "operationId": "revoke_session",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant de session",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session révoquée"
          },
          "404": {
            "description": "Session inconnue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Créer un compte. Connecte immédiatement (cookies posés).",
        "operationId": "signup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Compte créé et connecté",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Champ invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "E-mail ou pseudo déjà pris",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify-email": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Lien cliqué depuis l'e-mail. Redirige vers le front avec un statut.",
        "operationId": "verify_email",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "description": "Token du lien e-mail",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirection vers /verification?statut=ok|expire|invalide"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Arbre des catégories, fourchettes de valeur héritées de la racine.",
        "operationId": "categories",
        "responses": {
          "200": {
            "description": "Arbre des catégories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryNode"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Statut de l'API et de ses dépendances.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Statut de l'API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/items": {
      "post": {
        "tags": [
          "catalog"
        ],
        "summary": "Publier un objet.",
        "operationId": "create_item",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Objet publié",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "400": {
            "description": "Champ invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "E-mail non vérifié",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/items/photos/presign": {
      "post": {
        "tags": [
          "catalog"
        ],
        "summary": "URL présignées d'upload (1–8 photos, 15 min).",
        "operationId": "presign_photos",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresignRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "URL de PUT présignées",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PresignedPhoto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Fichier refusé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "E-mail non vérifié",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/items/{id}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Fiche d'un objet. Le propriétaire voit tout ; les autres uniquement\n`disponible` (404 sinon — ne pas révéler un objet masqué).",
        "operationId": "get_item",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant de l'objet",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Objet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "404": {
            "description": "Objet introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "catalog"
        ],
        "summary": "Supprimer un objet (propriétaire uniquement). Les photos sont retirées\ndu stockage ; l'objet disparaît du dressing et des fiches publiques.",
        "operationId": "delete_item",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant de l'objet",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Objet supprimé"
          },
          "404": {
            "description": "Objet introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "catalog"
        ],
        "summary": "Modifier un objet (propriétaire uniquement).",
        "operationId": "update_item",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant de l'objet",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Objet mis à jour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "400": {
            "description": "Champ ou transition invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Objet introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/items/{id}/photos": {
      "put": {
        "tags": [
          "catalog"
        ],
        "summary": "Remplace la liste ordonnée des photos (réordonnancement, ajout, retrait).",
        "operationId": "replace_photos",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant de l'objet",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplacePhotosRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Photos mises à jour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "400": {
            "description": "Liste invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Objet introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Son propre profil.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Profil de l'utilisateur connecté",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Non connecté",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "me"
        ],
        "summary": "Mettre à jour pseudo et code postal.",
        "operationId": "update_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Profil mis à jour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Champ invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Pseudo déjà pris",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/me/items": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Mon dressing (tous statuts).",
        "operationId": "my_items",
        "responses": {
          "200": {
            "description": "Mes objets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ItemResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/troqueurs/{pseudo}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Profil public d'un troqueur : ville approximative, ancienneté, dressing\nvisible (objets disponibles uniquement — jamais les masqués, Gherkin F1.2).",
        "operationId": "public_profile",
        "parameters": [
          {
            "name": "pseudo",
            "in": "path",
            "description": "Pseudo du troqueur",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profil public",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProfileResponse"
                }
              }
            }
          },
          "404": {
            "description": "Troqueur inconnu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiStatus": {
        "type": "string",
        "enum": [
          "ok",
          "degraded"
        ]
      },
      "CategoryNode": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "label",
          "children"
        ],
        "properties": {
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryNode"
            }
          },
          "icon": {
            "type": [
              "string",
              "null"
            ],
            "description": "Icône Lucide (racines uniquement)."
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "label": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "value_max_cents": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "value_min_cents": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Fourchette indicative en centimes (héritée de la racine)."
          }
        }
      },
      "CreateItemRequest": {
        "type": "object",
        "required": [
          "title",
          "description",
          "category_id",
          "condition",
          "value_cents",
          "delivery_pref",
          "photos"
        ],
        "properties": {
          "category_id": {
            "type": "integer",
            "format": "int32"
          },
          "condition": {
            "type": "string",
            "description": "`neuf`, `tres_bon_etat`, `bon_etat` ou `correct`.",
            "example": "tres_bon_etat"
          },
          "delivery_pref": {
            "type": "string",
            "description": "`main_propre`, `envoi` ou `les_deux`.",
            "example": "main_propre"
          },
          "description": {
            "type": "string"
          },
          "draft_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Identifiant de brouillon côté client (funnel de télémétrie)."
          },
          "duration_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Durée du flux de publication côté client (KPI « moins de 2 minutes »)."
          },
          "exchange_wishes": {
            "type": [
              "string",
              "null"
            ]
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Ids issus de /items/photos/presign, dans l'ordre d'affichage (1–8)."
          },
          "title": {
            "type": "string",
            "example": "Poussette Yoyo"
          },
          "value_cents": {
            "type": "integer",
            "format": "int32",
            "description": "Valeur indicative en centimes (100 à 200 000).",
            "example": 15000
          }
        }
      },
      "DbStatus": {
        "type": "string",
        "enum": [
          "ok",
          "unreachable"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Code d'erreur stable, destiné au front.",
            "example": "identifiants_invalides"
          },
          "message": {
            "type": "string",
            "description": "Message affichable."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "description": "Réponse du endpoint de santé.",
        "required": [
          "status",
          "version",
          "db"
        ],
        "properties": {
          "db": {
            "$ref": "#/components/schemas/DbStatus",
            "description": "État de la connexion PostgreSQL."
          },
          "status": {
            "$ref": "#/components/schemas/ApiStatus",
            "description": "Statut global de l'API."
          },
          "version": {
            "type": "string",
            "description": "Version du build (crate + SHA court du commit).",
            "example": "0.1.0+abc1234"
          }
        }
      },
      "ItemPhotoResponse": {
        "type": "object",
        "required": [
          "photo_id",
          "url",
          "position"
        ],
        "properties": {
          "photo_id": {
            "type": "string",
            "format": "uuid"
          },
          "position": {
            "type": "integer",
            "format": "int32"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "ItemResponse": {
        "type": "object",
        "required": [
          "id",
          "owner_id",
          "title",
          "description",
          "category_id",
          "condition",
          "status",
          "value_cents",
          "delivery_pref",
          "photos",
          "created_at"
        ],
        "properties": {
          "category_id": {
            "type": "integer",
            "format": "int32"
          },
          "condition": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "delivery_pref": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "exchange_wishes": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid"
          },
          "photos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemPhotoResponse"
            }
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "value_cents": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "PresignFile": {
        "type": "object",
        "required": [
          "content_type",
          "size"
        ],
        "properties": {
          "content_type": {
            "type": "string",
            "description": "`image/webp` ou `image/jpeg`.",
            "example": "image/webp"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "Taille en octets (≤ 5 Mo)."
          }
        }
      },
      "PresignRequest": {
        "type": "object",
        "required": [
          "files"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignFile"
            },
            "description": "1 à 8 fichiers à uploader."
          }
        }
      },
      "PresignedPhoto": {
        "type": "object",
        "required": [
          "photo_id",
          "upload_url"
