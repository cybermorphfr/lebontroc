# Développement local (avec docker-compose.dev.yml)
DATABASE_URL=postgres://lebontroc:lebontroc@localhost:5433/lebontroc
PORT=8080
RUST_LOG=info

# Auth (F0.2)
JWT_SECRET=change-moi-32-caracteres-minimum-svp
COOKIE_SECURE=false
APP_BASE_URL=http://localhost:3000
ANALYTICS_SALT=change-moi-aussi

# E-mail (Mailpit local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_FROM=Lebontroc <no-reply@lebontroc.brianplus.com>

# Stockage photos (MinIO local sur 127.0.0.1:9002)
S3_ENDPOINT=http://127.0.0.1:9002
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9002
S3_BUCKET=lebontroc-photos
S3_ACCESS_KEY=lebontroc
S3_SECRET_KEY=lebontroc-dev

# Front (next dev) : proxy /api vers l'API locale
API_PROXY_URL=http://localhost:8080
API_INTERNAL_URL=http://localhost:8080
